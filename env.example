# ============================================================
# IBM watsonx.ai (AI Studio) — API Configuration
# ============================================================
# Get these values from your IBM watsonx.ai project:
#   https://dataplatform.cloud.ibm.com
#
# IBM_API_KEY    — IBM Cloud API key (IAM)
#                  Create at: https://cloud.ibm.com/iam/apikeys
#
# IBM_PROJECT_ID — Your watsonx.ai project ID
#                  Found in: watsonx.ai → project → Manage → General → Project ID
#
# IBM_MODEL_ID   — Model to use for generation
#                  Recommended: ibm/granite-3-8b-instruct
#                  Other options: ibm/granite-3-2b-instruct, meta-llama/llama-3-1-8b-instruct
#
# IBM_URL        — Regional base URL for watsonx.ai API
#                  Options:
#                    https://us-south.ml.cloud.ibm.com
#                    https://eu-gb.ml.cloud.ibm.com
#                    https://au-syd.ml.cloud.ibm.com
# ============================================================
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_MODEL_ID=ibm/granite-3-3b-a800m-instruct
IBM_URL=https://au-syd.ml.cloud.ibm.com

# ============================================================
# Flask Application Configuration
# ============================================================
FLASK_SECRET_KEY=change_this_to_a_strong_random_secret_key_in_production
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================
# File Upload Configuration
# ============================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ============================================================
# Application Configuration
# ============================================================
APP_NAME=MedAssist AI
APP_VERSION=1.0.0
